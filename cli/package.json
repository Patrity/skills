    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "~4.1.11"
  }
}
