# --- server-only ---
# Strongly recommended in production: Vercel functions share egress IPs, so the
# unauthenticated GitHub limit (60/h per IP) runs out fast. Read-only scope is enough.
NUXT_GITHUB_TOKEN=
# Required in production: bearer secret for POST /api/revalidate.
NUXT_REVALIDATE_SECRET=change-me
# 'fs' (default locally) or 'github' (default on Vercel). SKILLS_SOURCE is read at
# build/dev time by nuxt.config.ts; the BUILT server reads NUXT_SKILLS_SOURCE.
SKILLS_SOURCE=fs
NUXT_SKILLS_SOURCE=fs
NUXT_SKILLS_DIR=skills

# --- public ---
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_GITHUB_OWNER=Patrity
NUXT_PUBLIC_GITHUB_REPO=skills
NUXT_PUBLIC_GITHUB_BRANCH=main

# --- analytics (BUILD-time, production only) ---
NUXT_PUBLIC_UMAMI_ID=
UMAMI_DOMAINS=
